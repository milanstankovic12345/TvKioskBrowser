<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TVAppBrowser" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryDark">@color/primary_red_dark</item>
        <item name="colorAccent">@color/primary_red_light</item>
        
        <item name="android:windowBackground">@color/background_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        
        <!-- Fully unhide for immersive -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.TVAppBrowser.Settings" parent="Theme.TVAppBrowser">
        <item name="android:windowBackground">@color/background_black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>

    <style name="Widget.TVAppBrowser.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:stateListAnimator">@null</item> <!-- No shadow -->
    </style>

    <style name="Widget.TVAppBrowser.Button.Secondary" parent="Widget.TVAppBrowser.Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>
</resources>