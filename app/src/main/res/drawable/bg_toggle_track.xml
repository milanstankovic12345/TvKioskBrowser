<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E30613" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- A red ring around it for focus -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <stroke android:width="2dp" android:color="#E30613" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_red" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/toggle_off" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
