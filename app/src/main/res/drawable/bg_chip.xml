<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_red_dark" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#E30613" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_red" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_dark" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
