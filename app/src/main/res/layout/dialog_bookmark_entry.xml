<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Bookmark"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Name"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/inputBookmarkName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:hint="e.g. Google"
        android:textColorHint="@color/text_muted"
        android:singleLine="true"
        android:maxLines="1"
        android:nextFocusDown="@+id/inputBookmarkUrl"
        android:scrollHorizontally="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="URL"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/inputBookmarkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:hint="https://"
        android:textColorHint="@color/text_muted"
        android:inputType="textUri"
        android:singleLine="true"
        android:maxLines="1"
        android:nextFocusDown="@+id/btnCancel"
        android:scrollHorizontally="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.TVAppBrowser.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusRight="@+id/btnDelete"
            android:text="CANCEL" />
            
        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.TVAppBrowser.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/error_red"
            android:visibility="gone"
            android:nextFocusLeft="@+id/btnCancel"
            android:nextFocusRight="@+id/btnSaveBookmark"
            android:text="DELETE" />

        <Button
            android:id="@+id/btnSaveBookmark"
            style="@style/Widget.TVAppBrowser.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:nextFocusLeft="@+id/btnDelete"
            android:text="SAVE" />
    </LinearLayout>
</LinearLayout>
