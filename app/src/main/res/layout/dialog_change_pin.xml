<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white"
    android:minWidth="300dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Administrator PIN"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter New PIN"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/newPinDigit1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="New PIN digit 1"
            android:nextFocusRight="@id/newPinDigit2"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/newPinDigit2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="New PIN digit 2"
            android:nextFocusLeft="@id/newPinDigit1"
            android:nextFocusRight="@id/newPinDigit3"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/newPinDigit3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="New PIN digit 3"
            android:nextFocusLeft="@id/newPinDigit2"
            android:nextFocusRight="@id/newPinDigit4"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/newPinDigit4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="New PIN digit 4"
            android:nextFocusLeft="@id/newPinDigit3" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm New PIN"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/confirmPinDigit1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Confirm PIN digit 1"
            android:nextFocusRight="@id/confirmPinDigit2"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/confirmPinDigit2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Confirm PIN digit 2"
            android:nextFocusLeft="@id/confirmPinDigit1"
            android:nextFocusRight="@id/confirmPinDigit3"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/confirmPinDigit3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Confirm PIN digit 3"
            android:nextFocusLeft="@id/confirmPinDigit2"
            android:nextFocusRight="@id/confirmPinDigit4"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/confirmPinDigit4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#000000"
            android:background="@drawable/pin_digit_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Confirm PIN digit 4"
            android:nextFocusLeft="@id/confirmPinDigit3" />
    </LinearLayout>

    <TextView
        android:id="@+id/pinChangeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/pinChangeCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#000000"
            android:background="@drawable/focused_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Cancel PIN change"
            android:nextFocusRight="@id/pinChangeSubmit"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/pinChangeSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textColor="#000000"
            android:background="@drawable/focused_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:importantForAccessibility="yes"
            android:contentDescription="Save new PIN"
            android:nextFocusLeft="@id/pinChangeCancel" />
    </LinearLayout>

</LinearLayout>

