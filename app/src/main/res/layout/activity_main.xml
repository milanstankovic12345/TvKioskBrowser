<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black">

    <!-- Main Layout Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Browser Bar Container -->
        <LinearLayout
            android:id="@+id/browserBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_browser_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/searchBarIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_globe"
                android:contentDescription="Security" />
                
            <ProgressBar
                android:id="@+id/searchBarProgress"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:visibility="gone"
                android:indeterminateTint="#9CA3AF" />

            <EditText
                android:id="@+id/searchBarUrlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/selector_search_bar_bg"
                android:fontFamily="monospace"
                android:hint="Search or enter URL"
                android:textColorHint="#4B5563"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:lines="1"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:nextFocusDown="@+id/webView"
                android:nextFocusRight="@+id/searchBarBookmarkBtn" />

            <ImageButton
                android:id="@+id/searchBarBookmarkBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_star_outline"
                android:scaleType="centerInside"
                android:focusable="true"
                android:nextFocusLeft="@+id/searchBarUrlInput"
                android:nextFocusRight="@+id/searchBarSettingsBtn"
                android:nextFocusDown="@+id/webView" />

            <ImageButton
                android:id="@+id/searchBarSettingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:focusable="true"
                android:nextFocusLeft="@+id/searchBarBookmarkBtn"
                android:nextFocusDown="@+id/webView" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nextFocusUp="@+id/searchBarUrlInput" />

    </LinearLayout>

    <!-- Offline Indicator Overlay -->
    <LinearLayout
        android:id="@+id/offlineIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/offline_indicator_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_toggle_track_on"
            android:backgroundTint="@color/error_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/offline_text"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
