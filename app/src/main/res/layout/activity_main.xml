<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Settings overlay, hidden by default; shown when back button is pressed -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="800dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start URL"
                android:textStyle="bold"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/inputUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:hint="http://server/path"
                android:textColor="#000000"
                android:textColorHint="#66000000"
                android:background="@drawable/focused_background"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="yes"
                android:contentDescription="Start URL input field"
                android:nextFocusDown="@id/inputIntervalSec" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh interval (seconds)"
                android:textStyle="bold"
                android:textColor="#000000" />

            <EditText
                android:id="@+id/inputIntervalSec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="300"
                android:textColor="#000000"
                android:textColorHint="#66000000"
                android:background="@drawable/focused_background"
                android:padding="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="yes"
                android:contentDescription="Refresh interval in seconds input field"
                android:nextFocusUp="@id/inputUrl"
                android:nextFocusDown="@id/seekZoom" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Webpage zoom"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/textZoomValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#000000"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <SeekBar
                android:id="@+id/seekZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="yes"
                android:contentDescription="Webpage zoom control"
                android:nextFocusUp="@id/inputIntervalSec" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recommended Sites"
                android:textStyle="bold"
                android:textColor="#000000" />

            <HorizontalScrollView
                android:id="@+id/recommendedSitesScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp">

                <LinearLayout
                    android:id="@+id/recommendedSitesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnAddSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add New Site"
                android:textColor="#000000"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:background="@drawable/focused_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="yes"
                android:contentDescription="Add new recommended site button"
                android:nextFocusUp="@id/seekZoom"
                android:nextFocusDown="@id/btnChangePin" />

            <Button
                android:id="@+id/btnChangePin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Administrator PIN"
                android:textColor="#000000"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:background="@drawable/focused_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:importantForAccessibility="yes"
                android:contentDescription="Change administrator PIN button"
                android:nextFocusUp="@id/btnAddSite"
                android:nextFocusDown="@id/btnCancel" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="#000000"
                    android:background="@drawable/focused_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Cancel button"
                    android:nextFocusUp="@id/btnAddSite"
                    android:nextFocusRight="@id/btnSave" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textColor="#000000"
                    android:background="@drawable/focused_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:importantForAccessibility="yes"
                    android:contentDescription="Save settings button"
                    android:nextFocusUp="@id/btnAddSite"
                    android:nextFocusLeft="@id/btnCancel" />
            </LinearLayout>
            
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
