<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration allows cleartext traffic for all HTTP connections
         This enables the app to work with local servers and IP addresses -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>


